# ApexStore Configuration
# High-Performance LSM-Tree Key-Value Store
#
# Every variable below is read by the code. The authoritative sources are
# `src/bin/server.rs` (engine settings) and `src/api/config.rs`
# (`ServerConfig::from_env`). Keep this file in sync with them -- `make env-check`
# fails the build when they drift apart.

# ===================================
# Server Configuration
# ===================================
HOST=0.0.0.0
PORT=8080

# Deployment environment label used by config validation warnings.
# Set to `production` to make the validator strict about insecure defaults.
ENVIRONMENT=development

# Payload size limits (in bytes)
MAX_JSON_PAYLOAD_SIZE=52428800  # 50MB
MAX_RAW_PAYLOAD_SIZE=52428800   # 50MB

# Feature flag cache TTL (in seconds)
FEATURE_CACHE_TTL=10

# Connection and concurrency settings
MAX_CONNECTIONS=10000            # Max concurrent connections
MAX_CONNECTIONS_PER_IP=100       # Max simultaneous connections from a single IP
BACKLOG=1024                     # TCP listen backlog size
WORKERS=                         # Worker threads (empty = auto-detect CPU cores)

# Rate limiting (per IP address)
RATE_LIMIT_ENABLED=true          # Enable/disable IP-based rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100  # Max requests per minute per IP

# ===================================
# Request Timeout Configuration
# ===================================
# Global timeout for API requests (in seconds)
REQUEST_TIMEOUT_SECONDS=30

# ===================================
# TLS / HTTPS Configuration
# ===================================
# When TLS_ENABLED=true, both TLS_CERT_PATH and TLS_KEY_PATH are required and
# the server additionally listens for HTTPS on TLS_PORT.
TLS_ENABLED=false
TLS_PORT=8443
TLS_CERT_PATH=                   # e.g. /etc/apexstore/tls/fullchain.pem
TLS_KEY_PATH=                    # e.g. /etc/apexstore/tls/privkey.pem

# ===================================
# CORS Configuration
# ===================================
# When CORS_ENABLED=false the server sends no CORS headers at all.
# CORS_ORIGINS is a comma-separated allow-list. Never use `*` in production.
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:4200

# ===================================
# Authentication Configuration
# ===================================
# Enable/disable Bearer Token authentication.
# Set to 'true' to require authentication for API endpoints.
# Default: false (backward compatible)
API_AUTH_ENABLED=false

# Token expiry in days (optional)
# If not set, tokens will never expire.
API_TOKEN_EXPIRY_DAYS=30

# ===================================
# Access Control (policy engine)
# ===================================
# Enables the per-operation/per-key policy middleware (`AccessController`).
# Independent of API_AUTH_ENABLED.
ACCESS_CONTROL_ENABLED=false

# ===================================
# Storage Configuration
# ===================================
# Data directory for WAL + SSTables. Read by `src/bin/server.rs`.
DATA_DIR=./.lsm_data
MEMTABLE_MAX_SIZE=4194304        # 4MB (the server's default)

# Block and cache configuration
BLOCK_SIZE=4096                  # 4KB
BLOCK_CACHE_SIZE_MB=64

# Bloom filter configuration
BLOOM_FALSE_POSITIVE_RATE=0.01   # 1%

# Sparse index configuration: one index entry every N keys.
SPARSE_INDEX_INTERVAL=16

# Prefix compression (block-level key prefix encoding)
# When enabled, consecutive keys within a block share their common prefix,
# reducing SSTable size by ~10-30% for keys with common prefixes.
PREFIX_COMPRESSION_ENABLED=false

# ===================================
# Replication Configuration
# ===================================
# REPLICATION_ROLE: `primary`, `replica`, or unset (standalone).
REPLICATION_ROLE=
# Comma-separated list of replica base URLs (primary role only).
REPLICA_ENDPOINTS=
# How often the primary pushes frames to replicas, in milliseconds.
REPLICATION_SYNC_INTERVAL_MS=1000

# ===================================
# Change Data Capture (CDC) Configuration
# ===================================
# CDC endpoint URL for streaming data changes to external systems.
# When set, CDC is enabled and all data mutations (set/delete) are posted
# as JSON events to the specified HTTP endpoint.
CDC_ENDPOINT=                    # e.g. http://localhost:9000/webhook

# ===================================
# Observability
# ===================================
# OTLP collector endpoint for traces and metrics. When unset, ApexStore falls
# back to console (`tracing_subscriber::fmt`) output only.
OTEL_EXPORTER_OTLP_ENDPOINT=     # e.g. http://localhost:4317

# ===================================
# Not yet wired to the environment
# ===================================
# The variables below exist as `LsmConfig` fields with builder methods, but no
# binary reads them from the environment yet. They are listed here so the gap is
# explicit rather than silently misleading:
#
#   DIR_PATH                    -- superseded by DATA_DIR
#   INDEX_INTERVAL              -- superseded by SPARSE_INDEX_INTERVAL
#   WAL_MAX_SIZE                -- LsmConfig::wal.max_wal_size, no env binding
#   WAL_ARCHIVE_ENABLED         -- LsmConfig::wal.archive_enabled, no env binding
#   WAL_CHECK_INTERVAL_SECS     -- no field and no env binding
#   WAL_SYNC_INTERVAL           -- compile-time const in src/storage/wal.rs
#   ENCRYPTION_ENABLED          -- see docs/CONFIGURATION.md; only the CLI can
#                                  supply an encryption key today
#   ENCRYPTION_KEY_PATH         -- idem
