{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "god",
    "shell": "/bin/bash",
    "snapshot": false,
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 12000
    },
    "permission": {
        "read": "allow",
        "edit": "ask",
        "bash": "ask"
    },
    "mcp": {
        "github": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-github"
            ],
            "environment": {
                "GITHUB_TOKEN": "{env:GH_TOKEN}"
            },
            "enabled": true
        },
        "cicd": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "tsx",
                ".opencode/mcp/cicd-server.ts"
            ],
            "enabled": true
        }
    }
}