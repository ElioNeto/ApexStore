{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .openclaude/hooks/pre-tool-bash.sh"
          }
        ]
      },
      {
        "matcher": "file_edit|file_write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .openclaude/hooks/pre-tool-file.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "file_edit|file_write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .openclaude/hooks/post-tool-lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .openclaude/hooks/stop-dod.sh"
          }
        ]
      }
    ]
  }
}
